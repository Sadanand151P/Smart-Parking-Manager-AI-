# Copy this file to .env and fill in real values for production.
# In the college/dev build, leaving these blank makes every external
# service (SMS, maps, payments) fall back to a safe mock — the app
# still runs and behaves correctly end-to-end.

# --- Backend ---
JWT_SECRET=change-this-to-a-long-random-string
DEBUG=1
PORT=5000

# --- SMS / OTP (MSG91) ---
# Leave blank to use the mock provider (OTP printed to console + stored in DB).
SMS_AUTH_KEY=

# --- Maps (Google Maps Platform or Mappls) ---
# Leave blank to use the mock geocoder (deterministic, non-real coordinates).
MAP_PROVIDER=mappls
MAP_API_KEY=

# --- Payments ---
# Leave blank to use the mock gateway (all non-cash payments auto-succeed).
PAYMENT_SECRET=

# --- Database (only used if you migrate to PostgreSQL) ---
DATABASE_URL=postgresql://user:password@localhost:5432/smartpark
